{
  "name": "dusk-and-dawn",
  "productName": "Dusk & Dawn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": "^24.18.0",
    "npm": "^11.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "dev:desktop": "concurrently --kill-others --success first \"npm run dev\" \"wait-on tcp:127.0.0.1:5173 && cross-env DUSK_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=1",
    "test:browser": "playwright test --project=chromium",
    "test:desktop": "playwright test --project=electron",
    "dist:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "1.87.0",
    "prettier": "3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.duskanddawn.prototype",
    "productName": "Dusk & Dawn",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
